# Kconfig fragment for the User-Mode Linux kernel that the synctest
# demos boot. kernel/build.sh merges it on top of the ARCH=um
# x86_64_defconfig.

# The kernel takes its clock from an external scheduler.
CONFIG_UML_TIME_TRAVEL_SUPPORT=y

# Virtio devices over vhost-user sockets, and virtio-net on top.
CONFIG_VIRTIO_UML=y
CONFIG_VIRTIO_NET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y

# Boot from an initramfs with no modules.
# CONFIG_MODULES is not set
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y

# Networking.
CONFIG_PACKET=y
CONFIG_IPV6=y
CONFIG_TUN=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_CUBIC=y

# Trim things that slow the build or the boot.
# CONFIG_SOUND is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_XTERM_CHAN is not set
CONFIG_CON_CHAN="fd:0,fd:1"
CONFIG_SSL_CHAN="null"
